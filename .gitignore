# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing, linting, and temporary caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.freebuff/
.backup_pre_remediation/

# Local databases and runtime checkpoints
/checkpoints/
/data/
*.db
*.sqlite
*.sqlite3

# Large Model Weights & Binary Checkpoints (preserves Modelfiles, configs, and source code)
*.pt
*.bin
*.safetensors
*.gguf
*.onnx
*.pth

# Workspaces user data (keep structure, ignore large local data)
workspaces/*
!workspaces/.gitkeep

# Rust / Tauri build artifacts
target/
src-tauri/target/
/llm-maker.exe
*.exe
WebView2Loader.dll
tauri_debug.log
**/*.rs.bk

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.next/
*.tsbuildinfo

# Logs and debug artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor caches
.vscode/
.idea/

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
