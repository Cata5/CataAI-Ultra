# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.freebuff/
.backup_pre_remediation/

# Local databases and runtime checkpoints
checkpoints/
data/
*.db
*.sqlite
*.sqlite3

# Workspaces user data (keep structure, ignore large local data)
workspaces/*
!workspaces/.gitkeep

# Logs and debug artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.next/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
