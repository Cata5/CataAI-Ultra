# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing, linting, and temporary caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.freebuff/
.backup_pre_remediation/

# Local databases and runtime checkpoints
/checkpoints/
/data/
*.db
*.sqlite
*.sqlite3

# Large Model Weights & Binary Checkpoints (preserves Modelfiles, configs, and source code)
*.pt
*.bin
*.safetensors
*.gguf
*.onnx
*.pth

# Workspaces user data (keep structure, ignore large local data)
workspaces/*
!workspaces/.gitkeep

# Rust / Tauri build artifacts
target/
src-tauri/target/
# Installer staging payloads (generated by scripts/build_installer.ps1)
/src-tauri/resources/app/
/src-tauri/resources/python/
/llm-maker.exe
*.exe
WebView2Loader.dll
tauri_debug.log
**/*.rs.bk

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/coverage/
.next/
*.tsbuildinfo

# Encrypted settings key (never commit; DPAPI-bound on Windows)
.secrets.key
*.key

# Local pip/temporary build directories
.pip-tmp/
.tmp-test/
.test-run/
.pytest-tmp/
.run-tmp-*/
/test_tmp/

# Website build output
website/node_modules/
website/.next/
website/out/
website/tsconfig.tsbuildinfo
website/next-env.d.ts

# Logs and debug artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor caches
.vscode/
.idea/

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
